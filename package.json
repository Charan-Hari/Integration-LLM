{
  "name": "Integration-LLM",
  "version": "1.2.0",
  "description": "A TypeScript library for provider-agnostic LLM integration with support for Azure OpenAI, AWS Bedrock, Google Vertex AI, Ollama, OpenAI, and Anthropic Claude using Strategy, Factory, and Adapter design patterns.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --project tsconfig.json",
    "lint": "eslint src --ext .ts",
    "demo": "ts-node --esm src/demo.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Charan-Hari/Integration-LLM.git"
  },
  "keywords": [
    "llm",
    "ai",
    "openai",
    "azure-openai",
    "aws-bedrock",
    "vertex-ai",
    "ollama",
    "claude",
    "anthropic",
    "typescript",
    "adapter-pattern",
    "strategy-pattern",
    "design-patterns"
  ],
  "author": "Charan Hari",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Charan-Hari/Integration-LLM/issues"
  },
  "homepage": "https://charan-hari.github.io/Integration-LLM/",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "node-fetch": "^3.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  }
}
